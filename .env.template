# Environment Configuration for AI Stock Project
# Copy this file to .env and fill in your credentials

# =============================================================================
# GITHUB MODELS CONFIGURATION (Free tier available)
# =============================================================================
# Get your GitHub Personal Access Token from: https://github.com/settings/tokens
# Permissions needed: No specific scopes required for GitHub Models
GITHUB_TOKEN=your_github_personal_access_token_here

# =============================================================================
# AZURE AI FOUNDRY CONFIGURATION
# =============================================================================
# Azure OpenAI Service credentials
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5  # Your deployment name
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id_here
AZURE_RESOURCE_GROUP=your_resource_group_name_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQL Server Database
DB_SERVER=LAPTOP-2DEO7474
DB_PORT=1433
DB_NAME=AI_Stocks
DB_USERNAME=sa2
DB_PASSWORD=Chanan1234
DB_DRIVER=ODBC Driver 18 for SQL Server

# Connection string template (auto-generated from above)
DB_CONN_STR=Driver={ODBC Driver 18 for SQL Server};Server=${DB_SERVER},${DB_PORT};Database=${DB_NAME};UID=${DB_USERNAME};PWD=${DB_PASSWORD};TrustServerCertificate=yes;

# =============================================================================
# STOCK DATA PROVIDERS
# =============================================================================
# Alpha Vantage (Free tier: 25 requests/day)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Polygon.io (Free tier: 5 calls/minute)
POLYGON_API_KEY=your_polygon_api_key_here

# Yahoo Finance (Free, no key required)
YAHOO_FINANCE_ENABLED=true

# =============================================================================
# AI CONFIGURATION
# =============================================================================
# Default AI model to use
DEFAULT_AI_MODEL=gpt5_mini

# AI request settings
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=30
AI_MAX_CONCURRENT_REQUESTS=5

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Application environment
ENVIRONMENT=development  # development, staging, production

# Logging level
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# Cache settings
REDIS_URL=redis://localhost:6379/0  # Optional: for caching

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# JWT Secret for API authentication (generate a random string)
JWT_SECRET=your_jwt_secret_key_here

# Encryption key for sensitive data (32 bytes, base64 encoded)
ENCRYPTION_KEY=your_32_byte_encryption_key_base64_encoded_here

# Optional Zoho Mail search tool defaults
ZOHO_EMAIL=you@yourdomain.com
ZOHO_APP_PASSWORD=
ZOHO_IMAP_HOST=imap.zoho.com
# streamlit run tools/zoho_microsoft_search_app.py --server.port 4720
ZOHO_SEARCH_PORT=4720

# =============================================================================
# STREAMLIT CONFIGURATION
# =============================================================================
# Streamlit app settings
STREAMLIT_PORT=8501
STREAMLIT_HOST=localhost

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Enable debug mode
DEBUG_MODE=true

# Enable AI tracing
AI_TRACING_ENABLED=true

# Performance monitoring
PERFORMANCE_MONITORING=true